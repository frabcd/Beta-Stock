{
  "name": "beta-stock",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first synthetic paper trading for US, Hong Kong, and Mainland China equities.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run --config tests/security/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "qa": "npm run lint && npm run typecheck && npm run test && npm run test:security && npm run build && npm run test:e2e",
    "experiments": "node scripts/run-experiments.mjs",
    "social-preview": "node scripts/generate-social-preview.mjs"
  },
  "keywords": [
    "stock-simulator",
    "paper-trading",
    "trading-simulator",
    "stock-market-simulator",
    "portfolio-simulator",
    "financial-simulation",
    "financial-education",
    "equities",
    "deepseek",
    "hong-kong-stocks",
    "china-stocks",
    "a-shares",
    "us-stocks",
    "market-microstructure",
    "local-first",
    "react",
    "typescript",
    "fastify"
  ],
  "author": "frabcd and Beta-Stock contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frabcd/Beta-Stock.git"
  },
  "homepage": "https://github.com/frabcd/Beta-Stock#readme",
  "bugs": {
    "url": "https://github.com/frabcd/Beta-Stock/issues"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "framer-motion": "^12.42.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
