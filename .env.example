# Development-only opt-in. Use a newly generated key; never expose it to Vite.
# The source marker prevents Beta-Stock from consuming an inherited ambient key accidentally.
BETA_STOCK_DEEPSEEK_KEY_SOURCE=env
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=1200

# Core development is portable and keeps writable state inside the current project.
# The one-click Windows launcher overrides this with its strict E:-drive preset.
BETA_STOCK_STORAGE_POLICY=portable
# BETA_STOCK_DATA_DIR=/path/to/Beta-Stock/.data
BETA_STOCK_HOST=127.0.0.1
BETA_STOCK_PORT=4173
# `npm run dev` explicitly permits Vite at 127.0.0.1:5173. A production start
# permits only its own origin unless additional loopback origins are opted in here.
# BETA_STOCK_ALLOWED_ORIGINS=http://127.0.0.1:5173
